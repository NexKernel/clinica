# Almacenamiento de archivos clinicos (fuera de /media, servidos con autorizacion)
STORAGE_DIR=storage
MAX_ATTACHMENT_BYTES=10485760

FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@estabridis.pe
FIRST_ADMIN_PASSWORD=Admin123*
FIRST_ADMIN_FULL_NAME=Administrador del Sistema

