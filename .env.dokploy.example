# Variables para pegar en Dokploy -> App (Compose) -> Environment.
# Dokploy las escribe a un .env junto al compose; NO commitear valores reales.

# Postgres gestionado por Dokploy. El host es el nombre del servicio de BD en
# Dokploy (p. ej. policlinico-postgresql-ab12cd), alcanzable por dokploy-network.
DATABASE_URL=postgresql+psycopg2://USUARIO:CLAVE@NOMBRE-SERVICIO-BD:5432/BASE

# Cadena aleatoria larga; rotarla invalida todas las sesiones.
SECRET_KEY=

# Cuenta de soporte técnico (desarrolladores). Se siembra en el primer arranque
# y se resincroniza en cada reinicio, así que cambiar aquí la contraseña y
# redesplegar es la forma de recuperar el acceso. No aparece en la gestión de
# usuarios de la aplicación ni se puede editar desde ella: este archivo es el
# único sitio donde vive. Si la contraseña lleva # o espacios, ponerla entre
# comillas dobles para que el .env de Dokploy no la corte.
FIRST_ADMIN_USERNAME=admin
FIRST_ADMIN_EMAIL=admin@estabridis.pe
FIRST_ADMIN_PASSWORD=
FIRST_ADMIN_FULL_NAME=Administrador del Sistema

# Opcionales: el compose ya trae estos valores por defecto.
BACKEND_CORS_ORIGINS=https://satipo.ose.lat
PUBLIC_APP_URL=https://satipo.ose.lat
ACCESS_TOKEN_EXPIRE_MINUTES=480
SHARE_LINK_HOURS=72
DEFAULT_PHONE_COUNTRY_CODE=51
MAX_ATTACHMENT_BYTES=10485760
